   "source": [
    "import cv2\n",
    "import time\n",
    "import numpy as np\n",
    "from ultralytics import YOLO\n",
    "\n",
   
    "model = YOLO(\"yolo11n.pt\")\n",
    "\n",
   
    "cap = cv2.VideoCapture(video_path)\n",
    "prev_time = 0\n",
   
    "roi_points = np.array([\n",
    " \n",
    "  [613, 351],\n",
    "  [486, 409],\n",
    "  [685, 498],\n",
    "  [780, 402]\n",
    "], np.int32)\n",
    "\n",
    "while cap.isOpened():\n",
    "    current_time = time.time()\n",
    "    fps = 1 / (current_time - prev_time) if prev_time != 0 else 0\n",
    "    prev_time = current_time\n",
    "    ret, frame = cap.read()\n",
    "\n",
    "    if not ret:\n",
    "        break\n",
    "\n",
    "   
    "    results = model.track(\n",
    "        frame,\n",
    "        persist=True,\n",
    "        tracker=\"botsort.yaml\",\n",
    "        classes=[0],\n",
    "        conf=0.5\n",
    "    )\n",
    "\n",
    "    annotated_frame = frame.copy()\n",
    "\n",
    "   
    "    cv2.polylines(\n",
    "        annotated_frame,\n",
    "        [roi_points],\n",
    "        True,\n",
    "        (0, 255, 255),\n",
    "        3\n",
    "    )\n",
    "\n",
    "    total_people = 0\n",
    "    roi_people = 0\n",
    "\n",
    "    if results[0].boxes is not None:\n",
    "\n",
    "        total_people = len(results[0].boxes)\n",
    "\n",
    "        for box in results[0].boxes:\n",
    "\n",
    "            x1, y1, x2, y2 = map(int, box.xyxy[0])\n",
    "\n",
    "            
    "            track_id = int(box.id)\n",
    "\n",
    "           
    "            cv2.rectangle(\n",
    "                annotated_frame,\n",
    "                (x1, y1),\n",
    "                (x2, y2),\n",
    "                (0, 255, 0),\n",
    "                2\n",
    "            )\n",
    "\n",
    "            
    "            cv2.putText(\n",
    "                annotated_frame,\n",
    "                f\"ID {track_id}\",\n",
    "                (x1, y1 - 10),\n",
    "                cv2.FONT_HERSHEY_SIMPLEX,\n",
    "                0.7,\n",
    "                (0, 255, 255),\n",
    "                2\n",
    "            )\n",
    "\n",
    "            
    "            cx = (x1 + x2) // 2\n",
    "            cy = int(y1 + (y2 - y1) * 0.50)\n",
    "\n",
    "            cv2.circle(\n",
    "                annotated_frame,\n",
    "                (cx, cy),\n",
    "                4,\n",
    "                (0, 0, 255),\n",
    "                -1\n",
    "            )\n",
    "\n",
    "           
    "            if cv2.pointPolygonTest(roi_points, (cx, cy), False) >= 0:\n",
    "                roi_people += 1\n",
    "\n",
    "    
    "    cv2.putText(\n",
    "        annotated_frame,\n",
    "        f\"Total People : {total_people}\",\n",
    "        (20, 40),\n",
    "        cv2.FONT_HERSHEY_SIMPLEX,\n",
    "        1,\n",
    "        (0, 255, 0),\n",
    "        2\n",
    "    )\n",
    "\n",
    "    cv2.putText(\n",
    "        annotated_frame,\n",
    "        f\"ROI People : {roi_people}\",\n",
    "        (20, 80),\n",
    "        cv2.FONT_HERSHEY_SIMPLEX,\n",
    "        1,\n",
    "        (255, 255, 0),\n",
    "        2\n",
    "    )\n",
    "\n",
    "    
    "    if roi_people > 2:\n",
    "\n",
    "        cv2.rectangle(\n",
    "            annotated_frame,\n",
    "            (350, 20),\n",
    "            (630, 90),\n",
    "            (0, 0, 255),\n",
    "            -1\n",
    "        )\n",
